{
  "compilerOptions": {
    "incremental": true,
    "declaration": true,
    "noEmit": true,
    "target": "es2015",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "removeComments": false,
    "lib": ["es6"],
    "skipLibCheck": true
  },
  "include": ["./packages"],
  "exclude": ["node_modules"]
}
